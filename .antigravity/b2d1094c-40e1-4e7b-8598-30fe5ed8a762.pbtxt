    instruction: "Fix video source loading and play error with automatic multi-source fallback and error handling"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Volume2, VolumeX, Play, Pause, Upload } from \'lucide-react\';\n\ninterface VideoItem {\n  id: string;\n  title: string;\n  subtitle: string;\n  videoSources: string[];\n}\n\nconst FEATURED_VIDEOS: VideoItem[] = [\n  {\n    id: \'1\',\n    title: \'Ayurvidhapeeth App Reel\',\n    subtitle: \'UGC & EdTech \342\200\224 9:16\',\n    videoSources: [\n      \'/reel1.mp4\',\n      \'https://assets.mixkit.co/videos/39767/39767-720.mp4\',\n    ],\n  },\n  {\n    id: \'2\',\n    title: \'Cinematic Reel Edit\',\n    subtitle: \'Reel / Short \342\200\224 9:16\',\n    videoSources: [\n      \'/reel2.mp4\',\n      \'https://assets.mixkit.co/videos/41530/41530-720.mp4\',\n    ],\n  },\n];\n\ninterface VideoCardProps {\n  video: VideoItem;\n}\n\nconst VideoCard: React.FC<VideoCardProps> = ({ video }) => {\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const [customVideoUrl, setCustomVideoUrl] = useState<string | null>(null);\n  const [customFileName, setCustomFileName] = useState<string | null>(null);\n  const [isMuted, setIsMuted] = useState(true);\n  const [isPlaying, setIsPlaying] = useState(false);\n\n  useEffect(() => {\n    const el = videoRef.current;\n    if (!el) return;\n\n    el.muted = true;\n    const playPromise = el.play();\n    if (playPromise !== undefined) {\n      playPromise\n        .then(() => {\n          setIsPlaying(true);\n        })\n        .catch(() => {\n          setIsPlaying(false);\n        });\n    }\n  }, [customVideoUrl, video]);\n\n  const toggleMute = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (videoRef.current) {\n      const nextMuted = !isMuted;\n      videoRef.current.muted = nextMuted;\n      setIsMuted(nextMuted);\n    }\n  };\n\n  const togglePlay = () => {\n    if (!videoRef.current) return;\n    if (isPlaying) {\n      videoRef.current.pause();\n      setIsPlaying(false);\n    } else {\n      videoRef.current\n        .play()\n        .then(() => {\n          setIsPlaying(true);\n        })\n        .catch((err) => {\n          console.error(\'Play error:\', err);\n        });\n    }\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const url = URL.createObjectURL(file);\n      setCustomVideoUrl(url);\n      setCustomFileName(file.name);\n      setIsPlaying(true);\n    }\n  };\n\n  const triggerUpload = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    fileInputRef.current?.click();\n  };\n\n  return (\n    <div className=\"flex flex-col items-center w-full max-w-[280px] sm:max-w-[320px] md:max-w-[340px]\">\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"video/*\"\n        onChange={handleFileUpload}\n        className=\"hidden\"\n      />\n\n      <div\n        onClick={togglePlay}\n        className=\"relative w-full aspect-[9/16] rounded-2xl sm:rounded-3xl overflow-hidden bg-[#141414] border border-[#222] shadow-2xl group hover:border-[#646973] transition-all duration-500 hover:scale-[1.02] cursor-pointer\"\n      >\n        <video\n          ref={videoRef}\n          key={customVideoUrl || video.id}\n          src={customVideoUrl || video.videoSources[0]}\n          autoPlay\n          loop\n          muted={isMuted}\n          playsInline\n          preload=\"auto\"\n          onPlay={() => setIsPlaying(true)}\n          onPause={() => setIsPlaying(false)}\n          className=\"w-full h-full object-cover\"\n        >\n          {!customVideoUrl &&\n            video.videoSources.map((src, idx) => (\n              <source key={idx} src={src} type=\"video/mp4\" />\n            ))}\n          Your browser does not support the video tag.\n        </video>\n\n        {/* Gradient Overlay */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-300 pointer-events-none\" />\n\n        {/* Top Controls Bar */}\n        <div className=\"absolute top-4 left-4 right-4 z-20 flex items-center justify-between\">\n          {/* Upload Button */}\n          <button\n            onClick={triggerUpload}\n            className=\"px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 flex items-center gap-1.5 text-xs text-white hover:bg-white hover:text-black transition-all duration-300 shadow-lg\"\n            title=\"Upload your MP4 video file directly\"\n          >\n            <Upload className=\"w-3.5 h-3.5\" />\n            <span>{customFileName ? \'Change\' : \'Upload Video\'}</span>\n          </button>\n\n          {/* Sound Toggle Button */}\n          <button\n            onClick={toggleMute}\n            className=\"w-9 h-9 rounded-full bg-black/60 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-black transition-all duration-300 shadow-lg\"\n            title={isMuted ? \'Unmute\' : \'Mute\'}\n          >\n            {isMuted ? <VolumeX className=\"w-4 h-4\" /> : <Volume2 className=\"w-4 h-4\" />}\n          </button>\n        </div>\n\n        {/* Play/Pause Overlay Button when paused */}\n        {!isPlaying && (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center z-15 bg-black/40 backdrop-blur-[2px] transition-all duration-300\">\n            <div className=\"w-16 h-16 rounded-full bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-xl hover:scale-110 transition-transform\">\n              <Play className=\"w-8 h-8 ml-1 fill-white text-white\" />\n            </div>\n            <span className=\"text-xs text-white/80 font-mono mt-3 uppercase tracking-wider\">\n              Click to Play\n            </span>\n          </div>\n        )}\n\n        {/* Pause hint on hover when playing */}\n        {isPlaying && (\n          <div className=\"absolute inset-0 flex items-center justify-center z-15 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\">\n            <div className=\"w-12 h-12 rounded-full bg-black/50 backdrop-blur-md border border-white/20 flex items-center justify-center text-white\">\n              <Pause className=\"w-5 h-5 fill-white\" />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom Info */}\n        <div className=\"absolute bottom-0 left-0 right-0 p-5 flex items-end justify-between z-10 pointer-events-none\">\n          <div>\n            <span className=\"text-[11px] uppercase tracking-wider text-[#646973] font-mono block\">\n              {customFileName ? \'Custom Upload\' : video.subtitle}\n            </span>\n            <h4 className=\"text-lg font-semibold text-[#D7E2EA] mt-0.5 truncate max-w-[240px]\">\n              {customFileName || video.title}\n            </h4>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState, useRef, useEffect, useCallback } from \'react\';\nimport { Volume2, VolumeX, Play, Pause, Upload, RefreshCw, AlertCircle } from \'lucide-react\';\n\ninterface VideoItem {\n  id: string;\n  title: string;\n  subtitle: string;\n  videoSources: string[];\n}\n\nconst FEATURED_VIDEOS: VideoItem[] = [\n  {\n    id: \'1\',\n    title: \'Ayurvidhapeeth App Reel\',\n    subtitle: \'UGC & EdTech \342\200\224 9:16\',\n    videoSources: [\n      \'/reel1.mp4\',\n      \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4\',\n      \'https://assets.mixkit.co/videos/39767/39767-720.mp4\',\n    ],\n  },\n  {\n    id: \'2\',\n    title: \'Cinematic Reel Edit\',\n    subtitle: \'Reel / Short \342\200\224 9:16\',\n    videoSources: [\n      \'/reel2.mp4\',\n      \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4\',\n      \'https://assets.mixkit.co/videos/41530/41530-720.mp4\',\n    ],\n  },\n];\n\ninterface VideoCardProps {\n  video: VideoItem;\n}\n\nconst VideoCard: React.FC<VideoCardProps> = ({ video }) => {\n  const videoRef = useRef<HTMLVideoElement>(null);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  const [customVideoUrl, setCustomVideoUrl] = useState<string | null>(null);\n  const [customFileName, setCustomFileName] = useState<string | null>(null);\n  const [sourceIndex, setSourceIndex] = useState(0);\n  const [hasError, setHasError] = useState(false);\n  const [isMuted, setIsMuted] = useState(true);\n  const [isPlaying, setIsPlaying] = useState(false);\n\n  const activeSources = customVideoUrl ? [customVideoUrl] : video.videoSources;\n  const currentSource = activeSources[sourceIndex] || activeSources[0];\n\n  const handleVideoError = useCallback(() => {\n    if (customVideoUrl) {\n      setHasError(true);\n      return;\n    }\n    if (sourceIndex < video.videoSources.length - 1) {\n      setSourceIndex((prev) => prev + 1);\n    } else {\n      setHasError(true);\n    }\n  }, [customVideoUrl, sourceIndex, video.videoSources]);\n\n  const attemptPlay = useCallback(async () => {\n    const el = videoRef.current;\n    if (!el || hasError) return;\n\n    el.muted = isMuted;\n    try {\n      await el.play();\n      setIsPlaying(true);\n    } catch (err) {\n      setIsPlaying(false);\n      if (\n        err instanceof Error &&\n        (err.name === \'NotSupportedError\' || err.message.includes(\'supported sources\'))\n      ) {\n        handleVideoError();\n      }\n    }\n  }, [hasError, isMuted, handleVideoError]);\n\n  useEffect(() => {\n    attemptPlay();\n  }, [currentSource, attemptPlay]);\n\n  const toggleMute = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    if (videoRef.current) {\n      const nextMuted = !isMuted;\n      videoRef.current.muted = nextMuted;\n      setIsMuted(nextMuted);\n    }\n  };\n\n  const togglePlay = () => {\n    if (!videoRef.current || hasError) return;\n    if (isPlaying) {\n      videoRef.current.pause();\n      setIsPlaying(false);\n    } else {\n      attemptPlay();\n    }\n  };\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      const url = URL.createObjectURL(file);\n      setCustomVideoUrl(url);\n      setCustomFileName(file.name);\n      setSourceIndex(0);\n      setHasError(false);\n      setIsPlaying(true);\n    }\n  };\n\n  const triggerUpload = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    fileInputRef.current?.click();\n  };\n\n  const handleRetry = (e: React.MouseEvent) => {\n    e.stopPropagation();\n    setHasError(false);\n    setSourceIndex(0);\n  };\n\n  return (\n    <div className=\"flex flex-col items-center w-full max-w-[280px] sm:max-w-[320px] md:max-w-[340px]\">\n      <input\n        ref={fileInputRef}\n        type=\"file\"\n        accept=\"video/*\"\n        onChange={handleFileUpload}\n        className=\"hidden\"\n      />\n\n      <div\n        onClick={togglePlay}\n        className=\"relative w-full aspect-[9/16] rounded-2xl sm:rounded-3xl overflow-hidden bg-[#141414] border border-[#222] shadow-2xl group hover:border-[#646973] transition-all duration-500 hover:scale-[1.02] cursor-pointer\"\n      >\n        {!hasError ? (\n          <video\n            ref={videoRef}\n            key={`${video.id}-${sourceIndex}-${customVideoUrl || \'default\'}`}\n            src={currentSource}\n            autoPlay\n            loop\n            muted={isMuted}\n            playsInline\n            preload=\"auto\"\n            onError={handleVideoError}\n            onPlay={() => setIsPlaying(true)}\n            onPause={() => setIsPlaying(false)}\n            className=\"w-full h-full object-cover\"\n          />\n        ) : (\n          <div className=\"w-full h-full flex flex-col items-center justify-center p-6 text-center bg-[#181818] text-[#D7E2EA] gap-3\">\n            <AlertCircle className=\"w-8 h-8 text-amber-400\" />\n            <p className=\"text-xs font-mono uppercase text-[#D7E2EA]/70\">\n              Video preview unavailable\n            </p>\n            <div className=\"flex items-center gap-2 mt-2\">\n              <button\n                onClick={handleRetry}\n                className=\"px-3 py-1.5 rounded-full bg-[#222] hover:bg-[#333] text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n              >\n                <RefreshCw className=\"w-3 h-3\" />\n                <span>Retry</span>\n              </button>\n              <button\n                onClick={triggerUpload}\n                className=\"px-3 py-1.5 rounded-full bg-[#B600A8] text-white hover:bg-[#a00094] text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n              >\n                <Upload className=\"w-3 h-3\" />\n                <span>Upload MP4</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Gradient Overlay */}\n        <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent opacity-80 group-hover:opacity-90 transition-opacity duration-300 pointer-events-none\" />\n\n        {/* Top Controls Bar */}\n        <div className=\"absolute top-4 left-4 right-4 z-20 flex items-center justify-between\">\n          {/* Upload Button */}\n          <button\n            onClick={triggerUpload}\n            className=\"px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md border border-white/20 flex items-center gap-1.5 text-xs text-white hover:bg-white hover:text-black transition-all duration-300 shadow-lg\"\n            title=\"Upload your MP4 video file directly\"\n          >\n            <Upload className=\"w-3.5 h-3.5\" />\n            <span>{customFileName ? \'Change\' : \'Upload Video\'}</span>\n          </button>\n\n          {/* Sound Toggle Button */}\n          {!hasError && (\n            <button\n              onClick={toggleMute}\n              className=\"w-9 h-9 rounded-full bg-black/60 backdrop-blur-md border border-white/20 flex items-center justify-center text-white hover:bg-white hover:text-black transition-all duration-300 shadow-lg\"\n              title={isMuted ? \'Unmute\' : \'Mute\'}\n            >\n              {isMuted ? <VolumeX className=\"w-4 h-4\" /> : <Volume2 className=\"w-4 h-4\" />}\n            </button>\n          )}\n        </div>\n\n        {/* Play/Pause Overlay Button when paused */}\n        {!isPlaying && !hasError && (\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center z-15 bg-black/40 backdrop-blur-[2px] transition-all duration-300\">\n            <div className=\"w-16 h-16 rounded-full bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-xl hover:scale-110 transition-transform\">\n              <Play className=\"w-8 h-8 ml-1 fill-white text-white\" />\n            </div>\n            <span className=\"text-xs text-white/80 font-mono mt-3 uppercase tracking-wider\">\n              Click to Play\n            </span>\n          </div>\n        )}\n\n        {/* Pause hint on hover when playing */}\n        {isPlaying && !hasError && (\n          <div className=\"absolute inset-0 flex items-center justify-center z-15 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none\">\n            <div className=\"w-12 h-12 rounded-full bg-black/50 backdrop-blur-md border border-white/20 flex items-center justify-center text-white\">\n              <Pause className=\"w-5 h-5 fill-white\" />\n            </div>\n          </div>\n        )}\n\n        {/* Bottom Info */}\n        <div className=\"absolute bottom-0 left-0 right-0 p-5 flex items-end justify-between z-10 pointer-events-none\">\n          <div>\n            <span className=\"text-[11px] uppercase tracking-wider text-[#646973] font-mono block\">\n              {customFileName ? \'Custom Upload\' : video.subtitle}\n            </span>\n            <h4 className=\"text-lg font-semibold text-[#D7E2EA] mt-0.5 truncate max-w-[240px]\">\n              {customFileName || video.title}\n            </h4>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
